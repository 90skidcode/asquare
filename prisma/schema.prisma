// A SQUARE Report Management System — Prisma schema
// Postgres, deployed via Vercel (Neon/Vercel Postgres)

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  DEALER
  INVESTOR
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum TripType {
  LOCAL
  OUTSTATION
  AIRPORT
  RENTAL
  ONE_WAY
  ROUND_TRIP
}

enum TripStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentType {
  CUSTOMER_RECEIPT
  DEALER_PAYMENT
  INVESTOR_SETTLEMENT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional linkage for DEALER / INVESTOR portal logins
  dealerId   String? @unique
  dealer     Dealer? @relation(fields: [dealerId], references: [id])
  investorId String? @unique
  investor   Investor? @relation(fields: [investorId], references: [id])

  createdTripSheets TripSheet[]   @relation("TripSheetCreatedBy")
  activityLogs      ActivityLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Entities
// ---------------------------------------------------------------------------

model Investor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  phone       String
  email       String?
  address     String?
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  joinDate    DateTime @default(now())
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?
  vehicles    Vehicle[]
  investments InvestmentRecord[]
  tripSheets  TripSheet[]
  payments    Payment[]

  @@map("investors")
}

model InvestmentRecord {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@map("investment_records")
}

model Dealer {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  phone          String
  email          String?
  address        String?
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User?
  vehicles   Vehicle[]
  tripSheets TripSheet[]
  payments   Payment[]

  @@map("dealers")
}

model Customer {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  phone          String
  email          String?
  address        String?
  billingAddress String?
  gstNumber      String?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tripSheets TripSheet[]
  payments   Payment[]

  @@map("customers")
}

model Vehicle {
  id           String        @id @default(cuid())
  plateNumber  String        @unique
  model        String
  type         String?
  capacity     Int?
  status       VehicleStatus @default(ACTIVE)
  investorId   String?
  investor     Investor?     @relation(fields: [investorId], references: [id])
  dealerId     String?
  dealer       Dealer?       @relation(fields: [dealerId], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tripSheets  TripSheet[]
  investments InvestmentRecord[]

  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Trip Sheet (core module)
// ---------------------------------------------------------------------------

model TripSheet {
  id          String   @id @default(cuid())
  tripNumber  String   @unique
  tripDate    DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  dealerId   String?
  dealer     Dealer?  @relation(fields: [dealerId], references: [id])
  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id])

  driverName      String
  driverPhone     String?
  driverLicenseNo String?

  pickupLocation String
  dropLocation   String
  tripType       TripType   @default(LOCAL)
  startDateTime  DateTime
  endDateTime    DateTime?

  openingKm     Decimal @default(0) @db.Decimal(10, 2)
  closingKm     Decimal @default(0) @db.Decimal(10, 2)
  totalKm       Decimal @default(0) @db.Decimal(10, 2) // closingKm - openingKm
  includedKm    Decimal @default(0) @db.Decimal(10, 2) // package/free km limit
  extraKm       Decimal @default(0) @db.Decimal(10, 2) // computed: max(totalKm - includedKm, 0)
  extraKmRate   Decimal @default(0) @db.Decimal(10, 2)
  extraKmAmount Decimal @default(0) @db.Decimal(12, 2) // computed: extraKm * extraKmRate

  waitingCharges Decimal @default(0) @db.Decimal(12, 2)
  tollCharges    Decimal @default(0) @db.Decimal(12, 2)
  parkingCharges Decimal @default(0) @db.Decimal(12, 2)
  driverBata     Decimal @default(0) @db.Decimal(12, 2)
  permitCharges  Decimal @default(0) @db.Decimal(12, 2)
  fuelCharges    Decimal @default(0) @db.Decimal(12, 2)
  otherExpenses  Decimal @default(0) @db.Decimal(12, 2)

  customerCharges   Decimal @default(0) @db.Decimal(12, 2) // total billed to customer
  dealerCharges     Decimal @default(0) @db.Decimal(12, 2) // commission/charges to dealer
  investorSettlement Decimal @default(0) @db.Decimal(12, 2) // amount settled to investor

  totalExpenses Decimal @default(0) @db.Decimal(12, 2) // computed sum of all expense fields
  netRevenue    Decimal @default(0) @db.Decimal(12, 2) // computed: customerCharges - totalExpenses

  tripStatus    TripStatus    @default(SCHEDULED)
  paymentStatus PaymentStatus @default(PENDING)
  remarks       String?

  createdById String
  createdBy   User   @relation("TripSheetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments TripAttachment[]
  payments    Payment[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([dealerId])
  @@index([investorId])
  @@index([tripDate])
  @@map("trip_sheets")
}

model TripAttachment {
  id          String    @id @default(cuid())
  tripSheetId String
  tripSheet   TripSheet @relation(fields: [tripSheetId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  uploadedAt  DateTime  @default(now())

  @@map("trip_attachments")
}

// ---------------------------------------------------------------------------
// Payments / Ledger
// ---------------------------------------------------------------------------

model Payment {
  id          String      @id @default(cuid())
  type        PaymentType
  amount      Decimal     @db.Decimal(12, 2)
  date        DateTime    @default(now())
  mode        PaymentMode @default(BANK_TRANSFER)
  reference   String?
  notes       String?

  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  dealerId    String?
  dealer      Dealer?    @relation(fields: [dealerId], references: [id])
  investorId  String?
  investor    Investor?  @relation(fields: [investorId], references: [id])
  tripSheetId String?
  tripSheet   TripSheet? @relation(fields: [tripSheetId], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([dealerId])
  @@index([investorId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Activity log
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String // e.g. "CREATE", "UPDATE", "DELETE"
  entityType  String // e.g. "TripSheet", "Customer"
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}
